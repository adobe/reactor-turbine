# LAUNCH QE API INTEGRATION
# Adobe Reactor SDK Integration Test Environment Variables
# Copy this file to .env and fill in your actual values

# Required: Adobe I/O Client Credentials (for @adobe/auth-token)
# Get these from Adobe Developer Console when you create your integration
RSDK_ADOBE_DEFAULT_COMPANY_CLIENT_ID=7db4f812299b4421a977be3702f49040
RSDK_ADOBE_DEFAULT_COMPANY_CLIENT_SECRET=s8e-kteNeixAo_wD01Wht4ThBxPim1HMMqzW
# Required: Your Reactor Company ID
# Format: CO1234567890abcdef1234567890abcdef
RSDK_ADOBE_REACTOR_DEFAULT_COMPANY_ID=COa947e6fc549e443fb1b3f99dccce2d9f
# Required: Your Adobe Organization ID
# Format: ORG123456789@AdobeOrg
RSDK_ADOBE_DEFAULT_COMPANY_ORG_ID=30C22A1D5B5755D40A494237@AdobeOrg

# Required: Adobe I/O Client Credentials (for @adobe/auth-token)
# Get these from Adobe Developer Console when you create your integration
RSDK_ADOBE_PREMIUM_COMPANY_CLIENT_ID=9880e3e90d4945f99b1625a332cac301
RSDK_ADOBE_PREMIUM_COMPANY_CLIENT_SECRET=s8e-b942adUlpvei6JY15aQF8kPNg6Sig0t1
# Required: Your Reactor Company ID
# Format: CO1234567890abcdef1234567890abcdef
RSDK_ADOBE_REACTOR_PREMIUM_COMPANY_ID=CO1cf1c3281ab243d485f4a54be3d9d745
# Required: Your Adobe Organization ID
# Format: ORG123456789@AdobeOrg
RSDK_ADOBE_PREMIUM_COMPANY_ORG_ID=30C22A1D5B5755D40A494237@AdobeOrg

# Required: Adobe auth scopes (comma-separated)
# Common scopes for Reactor API access
RSDK_ADOBE_SCOPES=AdobeID,openid,read_organizations,additional_info.job_function,additional_info.projectedProductContext,additional_info.roles

# Use https://reactor.adobe.io for production
# Use https://reactor-stage.adobe.io for staging
RSDK_ADOBE_REACTOR_URL=https://reactor-dev.adobe.io

# prod | stage
RSDK_ADOBE_ENVIRONMENT=stage

# Note: ACCESS_TOKEN will be generated automatically using @adobe/auth-token



