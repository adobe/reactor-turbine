{
  "name": "@adobe/reactor-turbine",
  "version": "29.0.0",
  "description": "Tags rule engine which processes rules on client websites and delegates logic to extensions.",
  "license": "Apache-2.0",
  "scripts": {
    "build:production": "NODE_ENV=production && npm run clean && rollup -c && npm run minify && npm run verify-no-test-code",
    "verify-no-test-code": "bash ./verify-no-test-code.sh",
    "clean": "rm -rf dist",
    "format": "pretty-quick",
    "lint": "eslint 'src/**/*.js' 'coreModulePackages/**/*.js'",
    "minify": "uglifyjs dist/engine.js -c -m -o dist/engine.min.js",
    "prepare": "husky install",
    "postinstall": "npx playwright install",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "karma start karma.unit.conf.js",
    "test:unit:ci:pull:request": "npm install karma-sauce-launcher@4.3.6 && karma start karma.unit.conf.js",
    "test:unit:ci:npm:publish": "karma start karma.unit.conf.js --browsers=ChromeHeadless --no-coverage",
    "ensure-integration-test-libraries": "node ci-scripts/ensure-integration-test-libraries.js --",
    "test:integration": "npm run build:production && npm run ensure-integration-test-libraries && playwright test",
    "test:integration:ci:npm:publish": "npm run build:production && npm run ensure-integration-test-libraries -- --force && playwright test"
  },
  "author": {
    "name": "Adobe Systems",
    "url": "http://adobe.com",
    "email": "reactor@adobe.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:adobe/reactor-turbine.git"
  },
  "dependencies": {
    "@adobe/reactor-cookie": "*",
    "@adobe/reactor-document": "*",
    "@adobe/reactor-load-script": "*",
    "@adobe/reactor-object-assign": "*",
    "@adobe/reactor-promise": "*",
    "@adobe/reactor-query-string": "*",
    "@adobe/reactor-window": "*",
    "is-plain-object": "^5.0.0",
    "lodash.clonedeep": "^4.5.0"
  },
  "devDependencies": {
    "@adobe/auth-token": "^1.0.1",
    "@adobe/reactor-sdk": "^2.0.0-beta.8",
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@playwright/test": "^1.56.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "babel-loader": "^10.0.0",
    "babel-plugin-istanbul": "^7.0.0",
    "camelize": "1.0.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "jasmine-core": "^5.8.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-matchers": "^5.0.0",
    "karma-safari-launcher": "^1.0.0",
    "karma-webpack": "^5.0.1",
    "kebab-case": "2.0.2",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "rollup": "^4.52.4",
    "rollup-plugin-strip-code": "^0.2.8",
    "serialize-javascript": "^7.0.0",
    "uglify-js": "^3.19.3",
    "webpack": "^5.99.9",
    "yargs": "^17.7.2"
  },
  "lint-staged": {
    "(src/**/*.js|coreModulePackages/**/*.js)": [
      "npm run lint -- --fix"
    ]
  },
  "engines": {
    "node": ">=v22.19.0"
  }
}
